<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Student</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Add Student</h1>

    <form class="student-form" action="/students" method="POST">
        <input type="text"
        name="name"
        placeholder="Name">
        <br><br>

        <input type="number"
        name="age"
        placeholder="Age">
        <br><br>

        <input type="text"
        name="course"
        placeholder="Course">
        <br></br>

        <input type="text"
        name="email"
        placeholder="Email">
        <br><br>

        <input type="text"
        name="city"
        placeholder="City">
        <br><br>

        <button>Add Student</button>
    </form>
</body>
</html>